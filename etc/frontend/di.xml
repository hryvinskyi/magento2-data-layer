<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Server events: the cart update whose quantity changes are reported -->
    <type name="Magento\Checkout\Model\Cart">
        <plugin name="hryvinskyi_datalayer_quantity_changes"
                type="Hryvinskyi\DataLayer\Plugin\Checkout\CartQuantityChangePlugin"/>
    </type>
    <!-- End of server events -->
</config>
