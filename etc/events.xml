<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Cached category trees: cleaned when a category changes, and again once its transaction commits, so a tree
         rebuilt by another request from the rows before the commit does not outlive it -->
    <event name="catalog_category_save_after">
        <observer name="hryvinskyi_datalayer_clean_category_tree"
                  instance="Hryvinskyi\DataLayer\Observer\CleanCategoryTree"/>
    </event>
    <event name="catalog_category_save_commit_after">
        <observer name="hryvinskyi_datalayer_clean_category_tree"
                  instance="Hryvinskyi\DataLayer\Observer\CleanCategoryTree"/>
    </event>
    <event name="catalog_category_delete_after">
        <observer name="hryvinskyi_datalayer_clean_category_tree"
                  instance="Hryvinskyi\DataLayer\Observer\CleanCategoryTree"/>
    </event>
    <event name="catalog_category_delete_commit_after">
        <observer name="hryvinskyi_datalayer_clean_category_tree"
                  instance="Hryvinskyi\DataLayer\Observer\CleanCategoryTree"/>
    </event>
    <event name="category_move">
        <observer name="hryvinskyi_datalayer_clean_category_tree"
                  instance="Hryvinskyi\DataLayer\Observer\CleanCategoryTree"/>
    </event>
    <!-- A store's root catalog decides which categories its tree holds -->
    <event name="store_group_save_after">
        <observer name="hryvinskyi_datalayer_clean_category_tree"
                  instance="Hryvinskyi\DataLayer\Observer\CleanCategoryTree"/>
    </event>
    <!-- Re-priced cart lines: a line an addition created or raised carries the product's raw price until its cart's
         totals run, so its figures are not reported as calculated before then. Global, so every area that adds to a
         cart is covered, and registered before any area's observer of the same addition. -->
    <event name="sales_quote_product_add_after">
        <observer name="hryvinskyi_datalayer_mark_repriced_cart_lines"
                  instance="Hryvinskyi\DataLayer\Observer\MarkRepricedCartLines"/>
    </event>
    <event name="sales_quote_collect_totals_after">
        <observer name="hryvinskyi_datalayer_mark_cart_totals_collected"
                  instance="Hryvinskyi\DataLayer\Observer\MarkCartTotalsCollected"/>
    </event>
    <!-- End of re-priced cart lines -->
</config>
