{
    "name": "hryvinskyi/magento2-data-layer",
    "description": "GA4 ecommerce data layer for Google Tag Manager: settings, events built on the server and while pages render, the item pipeline, product list data, the browser and server delivery channels.",
    "type": "magento2-module",
    "version": "1.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Volodymyr Hryvinskyi",
            "email": "volodymyr@hryvinskyi.com"
        }
    ],
    "require": {
        "php": "~8.3.0||~8.4.0",
        "hryvinskyi/magento2-data-layer-api": "^1.0",
        "magento/framework": "*",
        "magento/module-catalog": "*",
        "magento/module-checkout": "*",
        "magento/module-customer": "*",
        "magento/module-eav": "*",
        "magento/module-grouped-product": "*",
        "magento/module-quote": "*",
        "magento/module-sales": "*",
        "magento/module-store": "*",
        "magento/module-tax": "*",
        "magento/module-wishlist": "*",
        "psr/log": "*"
    },
    "replace": {
        "magento/module-google-adwords": "*",
        "magento/module-google-analytics": "*",
        "magento/module-google-gtag": "*",
        "magento/module-google-optimizer": "*"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Hryvinskyi\\DataLayer\\": ""
        }
    }
}
